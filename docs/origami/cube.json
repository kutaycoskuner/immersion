{
	"format": "immersion-fold",
	"version": 1,
	"name": "cube",
	"unit": "edge length 1",
	"points": {
		"p0": [0, 0],
		"p1": [1, 0],
		"p2": [1, 1],
		"p3": [0, 1],
		"p4": [0, -1],
		"p5": [1, -1],
		"p6": [0, 2],
		"p7": [1, 2],
		"p8": [-1, 0],
		"p9": [-1, 1],
		"p10": [2, 0],
		"p11": [2, 1],
		"p12": [0, 3],
		"p13": [1, 3]
	},
	"faces": {
		"bottom": { "points": ["p0", "p1", "p2", "p3"], "base": true },
		"front": { "points": ["p4", "p5", "p1", "p0"] },
		"back": { "points": ["p3", "p2", "p7", "p6"] },
		"left": { "points": ["p8", "p0", "p3", "p9"] },
		"right": { "points": ["p1", "p10", "p11", "p2"] },
		"top": { "points": ["p6", "p7", "p13", "p12"] }
	},
	"folds": [
		{ "id": "fold-front", "line": ["p0", "p1"], "fixed": "bottom", "moving": "front", "direction": "valley", "angle": 90, "step": 1, "type": "hinge" },
		{ "id": "fold-back", "line": ["p3", "p2"], "fixed": "bottom", "moving": "back", "direction": "valley", "angle": 90, "step": 1, "type": "hinge" },
		{ "id": "fold-left", "line": ["p0", "p3"], "fixed": "bottom", "moving": "left", "direction": "valley", "angle": 90, "step": 1, "type": "hinge" },
		{ "id": "fold-right", "line": ["p1", "p2"], "fixed": "bottom", "moving": "right", "direction": "valley", "angle": 90, "step": 1, "type": "hinge" },
		{ "id": "fold-top", "line": ["p6", "p7"], "fixed": "back", "moving": "top", "direction": "valley", "angle": 90, "step": 2, "type": "hinge" }
	],
	"steps": [
		{ "step": 1, "label": "raise the four sides around the bottom" },
		{ "step": 2, "label": "close the top" }
	]
}
